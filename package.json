{
    "name":  "@deepseek-ai/dsh-history-rewind",
    "version":  "0.1.0",
    "description":  "非线性会话历史回退：任意 TURN 状态可快照、可回退（同会话 id 原地热重载），git 影子仓库为唯一事实源。",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./invariant":  "./lib/invariant.js",
                    "./client":  "./lib/client.js",
                    "./src/*":  "./src/*",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web"
                           }
            },
    "license":  "MIT",
    "files":  [
                  "lib/index.js",
                  "lib/invariant.js",
                  "lib/client.js",
                  "cordis.patch.yml"
              ],
    "scripts":  {
                    "build":  "tsdown",
                    "watch":  "tsdown --watch",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "test":  "node --test --experimental-strip-types tests/*.test.ts"
                },
    "peerDependencies":  {
                             "react":  "^18.2.0",
                             "react-dom":  "^18.2.0",
                             "@deepseek-ai/cordis":  "^4.0.1"
                         },
    "devDependencies":  {
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1",
                            "@types/react":  "^18.3.31",
                            "@types/react-dom":  "^18.3.7",
                            "@types/node":  "^24.0.0",
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "tsdown":  "^0.9.0",
                            "typescript":  "^5.7.0"
                        }
}